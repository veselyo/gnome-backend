# Gnome Proxy Server Environment Variables
# Copy to .env and fill in your values, or set in Railway dashboard

# ============ Embedding & Vector DB (Required) ============

# Voyage AI - for text embeddings
VOYAGE_API_KEY=your-voyage-api-key

# Pinecone - for vector database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_HOST=https://your-index-xxxxxx.svc.region.pinecone.io

# ============ OAuth Secrets (Required for Google/Microsoft login) ============
# These are the CLIENT SECRETS - never share or put in the app

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (from portal.azure.com)
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ============ Port (Optional) ============
# Railway sets this automatically
PORT=8080
